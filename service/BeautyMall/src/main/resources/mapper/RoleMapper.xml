<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wzbc.BeautyMall.Mapper.RoleMapper">
    <resultMap id="roleMap" type="com.wzbc.BeautyMall.entity.PO.RolePO">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO sys_role (role_name, role_code, status, sort_order, remark, created_at, updated_at)
        VALUES (#{roleName}, #{roleCode}, #{status}, #{sortOrder}, #{remark}, #{createdAt}, #{updatedAt})
    </insert>
    <select id="selectByCode" resultMap="roleMap">
        SELECT * FROM sys_role WHERE role_code = #{code}
    </select>
    <select id="selectByIdForUpdate" resultMap="roleMap">
        SELECT * FROM sys_role WHERE id = #{id} FOR UPDATE
    </select>
    <select id="selectEnabledCodesByUserId" resultType="string">
        SELECT DISTINCT r.role_code FROM sys_role r
        INNER JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId} AND r.status = 1
    </select>
</mapper>
